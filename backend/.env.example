# Backend environment variables for Altrium PerformX 360°
# Copy this file to .env and fill in real values before running the server.

PORT=5001
NODE_ENV=development

# Local PostgreSQL connection string
# Default local install: user performx, database performx360, port 5432
DATABASE_URL=postgresql://performx@127.0.0.1:5432/performx360

# JWT configuration
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=30m

# Frontend origin for CORS (Vite default)
FRONTEND_URL=http://localhost:5173

# Cookie security — set to true in production HTTPS environments
COOKIE_SECURE=false

# Resend email service (optional until credentials are available)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
